# =============================================
# SecureCommerce Environment Configuration
# =============================================
# Copy this file to .env and modify as needed

# =============================================
# Backend Configuration
# =============================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB
MONGO_URI=mongodb://localhost:27017/secure_commerce

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_RESET_EXPIRY=1h

# Bcrypt
BCRYPT_ROUNDS=12

# MFA
MFA_ISSUER=SecureCommerce

# Security
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
MAX_FAILED_LOGINS=10
LOGIN_BLOCK_MINUTES=15

# Fraud Detection
FRAUD_THRESHOLD=0.7
FRAUD_SERVICE_URL=http://localhost:8000

# Email (SMTP)
EMAIL_FROM=noreply@securecommerce.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=./logs

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# =============================================
# Frontend Configuration
# =============================================

# API URL
VITE_API_URL=http://localhost:5000/api/v1

# =============================================
# Fraud Service Configuration
# =============================================

# Server
FRAUD_SERVICE_PORT=8000
FRAUD_SERVICE_HOST=0.0.0.0
DEBUG=false

# Redis
FRAUD_REDIS_HOST=localhost
FRAUD_REDIS_PORT=6379
FRAUD_REDIS_PASSWORD=

# Pub/Sub Channels
FRAUD_CHECK_CHANNEL=fraud_check
FRAUD_RESPONSE_CHANNEL=fraud_response

# ML Model
MODEL_PATH=./models/fraud_model.pkl
ENCODER_PATH=./models/label_encoders.pkl
SCALER_PATH=./models/scaler.pkl
CONFIDENCE_THRESHOLD=0.7

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=100

# =============================================
# Docker Configuration
# =============================================

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secure_password_change_me

# Redis
REDIS_DOCKER_PASSWORD=redis_password_change_me